{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@features/*": ["./src/features/*"],
      "@ui/*": ["./src/ui/*"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
