# generated by pnpm
pnpm-lock.yaml

# markdown is not formatted: prettier would re-pad every docs table and create churn in reviewed docs
**/*.md

# shell hooks are not a prettier language; husky generates .husky/_
.husky/

# the database side of supabase/ (sql, toml, cli state) has no prettier parser here (no plugin
# added); the edge functions are typescript and formatted, their deno entry (index.ts) included.
# a folder ignored as a whole cannot be re-included, so supabase/ ignores its entries instead
/supabase/*
!/supabase/functions/
