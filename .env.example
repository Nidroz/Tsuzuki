# build-time env of the app (ADR-0012), validated by app.config.ts with src/core/schemas/app-env.ts.
# copy to .env.local (git-ignored, never committed) or pull it with:
#   pnpm exec eas env:pull --environment development
# placeholders only: real values live in the EAS environments. every value below ships in the app
# by design (none is a secret); the supabase service_role key never goes here

# development | preview | production (app id, name and sentry environment)
APP_VARIANT=development
# https only: development builds use the staging project
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# the publishable key (sb_publishable_...) or the legacy anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>
# optional: empty disables sentry (it is always off in development)
SENTRY_DSN=
